{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ],
        "excludes": [
            "SuareSuPyrusClientSymfonyBundle.php",
            "SuareSuPyrusClientSymfonyCheckFormComponentPass.php",
            "PyrusSerializer.php"
        ]
    },
    "logs": {
        "text": "infection.log"
    },
    "mutators": {
        "@default": true,
        "CastString": false,
        "CastInt": false,
        "CastArray": false,
        "Coalesce": false,
        "ConcatOperandRemoval": false,
        "Concat": false,
        "NotIdentical": {
            "ignore": [
                "SuareSu\\PyrusClientSymfony\\PyrusSymfonyHttpTransport::uploadFile"
            ]
        },
        "FalseValue": {
            "ignore": [
                "SuareSu\\PyrusClientSymfony\\PyrusSymfonyHttpTransport::uploadFile"
            ]
        }
    }
}